# ===== OpenAI =====
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_MINI=gpt-4o-mini

# ===== Gmail =====
# Ruta al client_secret.json descargado desde Google Cloud Console
GOOGLE_CLIENT_SECRETS=./secrets/client_secret.json
# Token OAuth cacheado (se genera en el primer login)
GOOGLE_TOKEN_PATH=./secrets/token.json

# Correo a monitorear (opcional: por defecto la cuenta autenticada)
GMAIL_MONITORED_LABEL=INBOX
# Filtro adicional de búsqueda Gmail (query string)
GMAIL_QUERY_FILTER=is:unread subject:(proyecto OR agropecuario)

# ===== Aplicación =====
APP_ENV=development
LOG_LEVEL=INFO
# Base de datos local para estado y deduplicación
DB_PATH=./data/agropecuario.sqlite
# Carpeta temporal para adjuntos
TEMP_DIR=./data/tmp
# Carpeta donde quedan los entregables (Excel + PDF). Es la ÚNICA copia.
OUTPUT_DIR=./data/output

# ===== Rutas de configuración =====
RULES_PATH=./config/rules.yaml
TEMPLATE_PATH=./config/template.yaml
